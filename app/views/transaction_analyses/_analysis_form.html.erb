<%= render DS::Card.new(class: "gap-5") do %>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h1 id="analysis-workspace-title" class="text-xl font-medium text-primary"><%= analysis.title %></h1>
      <p class="mt-1 text-sm text-secondary"><%= t(".description") %></p>
    </div>
    <% unless @ai_configured %>
      <%= render DS::Pill.new(label: t(".ai_not_configured"), tone: :warning, marker: false, icon: "triangle-alert") %>
    <% end %>
  </div>

  <% unless @ai_configured %>
    <%= render DS::Alert.new(title: t(".ai_configuration_title"), message: t(".ai_configuration_description"), variant: :warning, live: :status) do %>
      <%= render DS::Link.new(text: t(".configure_ai"), href: settings_providers_path) %>
    <% end %>
  <% end %>

  <%= form_with url: transaction_analysis_runs_path(analysis), scope: :run, id: "transaction-analysis-form", class: "space-y-5" do |form| %>
    <%= form.hidden_field :account_ids, value: "", multiple: true %>
    <fieldset>
      <legend class="text-sm font-medium text-primary"><%= t(".accounts") %></legend>
      <p class="mt-1 text-xs text-secondary"><%= t(".accounts_hint") %></p>
      <div class="mt-3 grid gap-2 sm:grid-cols-2">
        <% @accessible_accounts.each do |account| %>
          <label class="flex min-w-0 items-center gap-2 rounded-lg border border-primary bg-container-inset px-3 py-2 text-sm text-primary">
            <%= form.check_box :account_ids, { multiple: true, checked: true, class: "shrink-0 rounded border-primary text-link focus-ring" }, account.id, nil %>
            <span class="truncate"><%= account.name %></span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <fieldset class="grid gap-3 sm:grid-cols-2">
      <legend class="sr-only"><%= t(".date_range") %></legend>
      <div>
        <%= form.label :start_date, t(".start_date"), class: "block text-sm font-medium text-primary mb-1" %>
        <%= form.date_field :start_date, value: 12.months.ago.to_date, required: true, class: "w-full rounded-lg border border-primary bg-container-inset px-3 py-2 text-sm text-primary focus-ring" %>
      </div>
      <div>
        <%= form.label :end_date, t(".end_date"), class: "block text-sm font-medium text-primary mb-1" %>
        <%= form.date_field :end_date, value: Date.current, required: true, class: "w-full rounded-lg border border-primary bg-container-inset px-3 py-2 text-sm text-primary focus-ring" %>
      </div>
      <label class="sm:col-span-2 flex items-center gap-2 text-sm text-primary">
        <%= form.check_box :all_history, class: "rounded border-primary text-link focus-ring" %>
        <span><%= t(".all_history") %></span>
      </label>
    </fieldset>

    <div>
      <%= form.label :prompt, t(".prompt"), class: "block text-sm font-medium text-primary mb-1" %>
      <%= form.text_area :prompt, required: true, rows: 4, maxlength: 10_000, placeholder: t(".prompt_placeholder"), class: "w-full rounded-lg border border-primary bg-container-inset px-3 py-2 text-sm text-primary focus-ring" %>
    </div>

    <%= render DS::Button.new(text: t(".run_analysis"), icon: "sparkles", type: "submit", disabled: !@ai_configured) %>
  <% end %>
<% end %>
