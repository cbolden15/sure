<section class="privacy-sensitive" aria-labelledby="<%= dom_id(run, :calculations) %>">
  <h3 id="<%= dom_id(run, :calculations) %>" class="text-sm font-medium text-primary"><%= t(".title") %></h3>
  <div class="mt-3 grid gap-3 lg:grid-cols-2">
    <% run.deterministic_output.fetch("calculations", []).each do |calculation| %>
      <div class="rounded-lg border border-primary bg-container-inset p-4">
        <div class="flex items-center justify-between gap-3">
          <h4 class="text-sm font-medium text-primary"><%= transaction_analysis_operation_label(calculation["operation"]) %></h4>
          <span class="font-mono text-xs text-secondary"><%= calculation["token"] %></span>
        </div>
        <% scalar_values = transaction_analysis_scalar_values(calculation.fetch("values", {})) %>
        <% if scalar_values.any? %>
          <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
            <% scalar_values.each do |key, value| %>
              <dt class="text-secondary"><%= transaction_analysis_value_label(key) %></dt>
              <dd class="text-right font-medium text-primary tabular-nums"><%= transaction_analysis_display_value(value) %></dd>
            <% end %>
          </dl>
        <% end %>
        <% rows = calculation.dig("values", "rows") %>
        <% if rows.is_a?(Array) && rows.any? %>
          <div class="mt-3 overflow-x-auto">
            <table class="min-w-full text-left text-xs">
              <thead class="border-b border-divider text-secondary">
                <tr>
                  <th scope="col" class="px-2 py-2 font-medium"><%= t(".table.item") %></th>
                  <th scope="col" class="px-2 py-2 text-right font-medium"><%= t(".table.count") %></th>
                  <th scope="col" class="px-2 py-2 text-right font-medium"><%= t(".table.income") %></th>
                  <th scope="col" class="px-2 py-2 text-right font-medium"><%= t(".table.expenses") %></th>
                </tr>
              </thead>
              <tbody>
                <% rows.each do |row| %>
                  <tr class="border-b border-divider last:border-0">
                    <td class="px-2 py-2 text-primary"><%= row.fetch("dimensions", {}).values.join(", ") %></td>
                    <td class="px-2 py-2 text-right text-secondary tabular-nums"><%= row["count"] %></td>
                    <td class="px-2 py-2 text-right text-primary tabular-nums"><%= transaction_analysis_display_value(row["income"]) %></td>
                    <td class="px-2 py-2 text-right text-primary tabular-nums"><%= transaction_analysis_display_value(row["expenses"]) %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
