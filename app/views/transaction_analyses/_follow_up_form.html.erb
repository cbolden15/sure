<section class="border-t border-divider pt-4" aria-labelledby="<%= dom_id(run, :follow_up) %>">
  <h3 id="<%= dom_id(run, :follow_up) %>" class="text-sm font-medium text-primary"><%= t(".title") %></h3>
  <%= form_with url: transaction_analysis_runs_path(analysis), scope: :run, class: "mt-3 flex flex-col gap-3 sm:flex-row" do |form| %>
    <% Array(run.scope["account_ids"]).each do |account_id| %><%= form.hidden_field :account_ids, multiple: true, value: account_id %><% end %>
    <%= form.hidden_field :start_date, value: run.scope["start_date"] %>
    <%= form.hidden_field :end_date, value: run.scope["end_date"] %>
    <%= form.hidden_field :all_history, value: run.scope["all_history"] %>
    <%= form.label :prompt, t(".prompt"), class: "sr-only" %>
    <%= form.text_field :prompt, required: true, maxlength: 10_000, placeholder: t(".placeholder"), class: "min-w-0 flex-1 rounded-lg border border-primary bg-container-inset px-3 py-2 text-sm text-primary focus-ring" %>
    <%= render DS::Button.new(text: t(".submit"), icon: "arrow-up", type: "submit", disabled: !ai_configured) %>
  <% end %>
</section>
